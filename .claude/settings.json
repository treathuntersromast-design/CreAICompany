{
  "enabledPlugins": {
    "cre-ai-team@cre-tools": false
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Grep(.env)",
      "Grep(.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat *.env*)",
      "Bash(cat */.env*)",
      "Bash(type .env*)",
      "Bash(type *.env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(more .env*)",
      "Bash(findstr * .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(type .env*)",
      "Read(**/*.pem)",
      "Grep(**/*.pem)",
      "Read(**/.credentials.json)",
      "Read(**/*credentials*)",
      "Grep(**/*credentials*)"
    ]
  }
}
